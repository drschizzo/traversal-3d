{
  "name": "traversal-3d",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "engine": "sh engine/build.sh",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.160.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "description": "Traversal 3D : le jeu (web/), ses règles partagées (core/), le serveur des salons (server/) et le bot (engine/)",
  "engines": {
    "node": ">=20"
  }
}
